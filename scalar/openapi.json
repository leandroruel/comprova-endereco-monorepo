{
  "openapi": "3.1.0",
  "info": {
    "title": "Document Intelligence",
    "description": "Processamento documental com Marker (OCR + layout, sem LLM)",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Status do servi\u00e7o. N\u00e3o carrega modelos do Marker.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "Indica se o servi\u00e7o est\u00e1 pronto para receber infer\u00eancias.\n\nRetorna **HTTP 200** somente quando os modelos est\u00e3o carregados, o warmup\nconcluiu (quando habilitado) e h\u00e1 mem\u00f3ria livre suficiente. Caso contr\u00e1rio,\n**HTTP 503** com ``status: \"not_ready\"`` no corpo \u2014 sinal que orquestradores\nusam para n\u00e3o rotear tr\u00e1fego.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Ainda n\u00e3o pronto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/documents/parse": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Parse Document",
        "description": "Recebe um PDF via ``multipart/form-data`` e retorna JSON estruturado.\n\nFluxo e garantias:\n- **admiss\u00e3o antes da leitura**: se a capacidade (worker + aguardando) est\u00e1\n  esgotada, responde ``429`` sem carregar o corpo em mem\u00f3ria;\n- somente PDFs v\u00e1lidos (assinatura ``%PDF-`` + magic bytes);\n- tamanho dentro do limite configurado (leitura em blocos, 413 cedo);\n- PDF n\u00e3o criptografado e dentro do limite de p\u00e1ginas;\n- nome de arquivo tempor\u00e1rio aleat\u00f3rio com limpeza garantida.\n\nO slot de admiss\u00e3o \u00e9 liberado em todos os caminhos: erro de valida\u00e7\u00e3o,\nupload acima do limite, falha ao agendar o executor, cancelamento do\ncliente e timeout. Quando o trabalho j\u00e1 est\u00e1 no worker, a libera\u00e7\u00e3o\nacontece no callback do future \u2014 nunca antes de a thread terminar.",
        "operationId": "parse_document_documents_parse_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_document_documents_parse_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BBox": {
        "properties": {
          "x1": {
            "type": "number",
            "title": "X1"
          },
          "y1": {
            "type": "number",
            "title": "Y1"
          },
          "x2": {
            "type": "number",
            "title": "X2"
          },
          "y2": {
            "type": "number",
            "title": "Y2"
          }
        },
        "type": "object",
        "required": [
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "title": "BBox",
        "description": "Coordenadas de bounding box de um elemento (em pontos do PDF)."
      },
      "Body_parse_document_documents_parse_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Arquivo PDF a ser processado"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id",
            "description": "Identificador opcional de processamento"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_parse_document_documents_parse_post"
      },
      "DocumentElement": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "bbox": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BBox"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "table": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Table"
              },
              {
                "type": "null"
              }
            ]
          },
          "imageRef": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imageref"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "title": "DocumentElement",
        "description": "Elemento estrutural de uma p\u00e1gina."
      },
      "DocumentInfo": {
        "properties": {
          "mimeType": {
            "type": "string",
            "title": "Mimetype"
          },
          "pageCount": {
            "type": "integer",
            "title": "Pagecount"
          },
          "sizeBytes": {
            "type": "integer",
            "title": "Sizebytes"
          }
        },
        "type": "object",
        "required": [
          "mimeType",
          "pageCount",
          "sizeBytes"
        ],
        "title": "DocumentInfo",
        "description": "Metadados do documento processado."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "document-intelligence"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          },
          "marker_available": {
            "type": "boolean",
            "title": "Marker Available",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "Page": {
        "properties": {
          "pageNumber": {
            "type": "integer",
            "title": "Pagenumber"
          },
          "elements": {
            "items": {
              "$ref": "#/components/schemas/DocumentElement"
            },
            "type": "array",
            "title": "Elements"
          },
          "width": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          },
          "height": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "pageNumber"
        ],
        "title": "Page",
        "description": "Uma p\u00e1gina do documento."
      },
      "ParseResponse": {
        "properties": {
          "documentId": {
            "type": "string",
            "title": "Documentid"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "document": {
            "$ref": "#/components/schemas/DocumentInfo"
          },
          "content": {
            "additionalProperties": true,
            "type": "object",
            "title": "Content",
            "description": "Conte\u00fado extra\u00eddo (texto completo, markdown, etc.)"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/Page"
            },
            "type": "array",
            "title": "Pages"
          },
          "metadata": {
            "$ref": "#/components/schemas/ProcessingMetadata"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errorcode"
          },
          "errorMessage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errormessage"
          }
        },
        "type": "object",
        "required": [
          "documentId",
          "status",
          "document",
          "metadata"
        ],
        "title": "ParseResponse",
        "description": "Resposta do endpoint ``POST /documents/parse``."
      },
      "ProcessingMetadata": {
        "properties": {
          "processor": {
            "type": "string",
            "title": "Processor",
            "default": "marker"
          },
          "processorVersion": {
            "type": "string",
            "title": "Processorversion"
          },
          "processingTimeMs": {
            "type": "integer",
            "title": "Processingtimems"
          },
          "contractVersion": {
            "type": "string",
            "title": "Contractversion",
            "default": "1.0"
          }
        },
        "type": "object",
        "required": [
          "processorVersion",
          "processingTimeMs"
        ],
        "title": "ProcessingMetadata",
        "description": "Metadados do processamento."
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "document-intelligence"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          },
          "models_loaded": {
            "type": "boolean",
            "title": "Models Loaded",
            "default": false
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ReadyResponse"
      },
      "Table": {
        "properties": {
          "headers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Headers"
          },
          "rows": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Rows"
          },
          "cells": {
            "items": {
              "$ref": "#/components/schemas/TableCell"
            },
            "type": "array",
            "title": "Cells"
          },
          "bbox": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BBox"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "Table",
        "description": "Representa\u00e7\u00e3o estruturada de uma tabela."
      },
      "TableCell": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "row": {
            "type": "integer",
            "title": "Row"
          },
          "column": {
            "type": "integer",
            "title": "Column"
          },
          "rowspan": {
            "type": "integer",
            "title": "Rowspan",
            "default": 1
          },
          "colspan": {
            "type": "integer",
            "title": "Colspan",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "text",
          "row",
          "column"
        ],
        "title": "TableCell",
        "description": "C\u00e9lula de uma tabela."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:8001",
      "description": "Document Intelligence API (CORS enabled)"
    }
  ]
}
