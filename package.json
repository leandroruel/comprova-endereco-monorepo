{
  "name": "comprova-endereco",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --project dashboard",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "turbo typecheck",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:logs:up": "docker compose -f docker-compose.yml -f docker-compose.elk.yml --profile elk up -d elasticsearch kibana-setup kibana filebeat",
    "compose:logs:down": "docker compose -f docker-compose.yml -f docker-compose.elk.yml --profile elk stop kibana filebeat kibana-setup elasticsearch",
    "db:migrate": "tsx --env-file=.env packages/db/src/migrate.ts",
    "db:migrate:reference": "tsx --env-file=.env packages/db/src/migrate-reference-schema.ts",
    "db:migrate-reference-data": "tsx --env-file=.env packages/db/src/migrate-reference.ts",
    "db:seed": "tsx --env-file=.env packages/db/src/bootstrap.ts",
    "db:provision-key": "tsx --env-file=.env apps/api/src/scripts/provision-signing-key.ts",
    "db:rotate-key": "tsx --env-file=.env apps/api/src/scripts/rotate-signing-key.ts",
    "db:provision-kms-key": "tsx --env-file=.env apps/api/src/scripts/provision-aws-kms-signing-key.ts",
    "db:rotate-kms-key": "tsx --env-file=.env apps/api/src/scripts/rotate-aws-kms-signing-key.ts",
    "db:fence": "pgfence analyze --ci --max-risk medium packages/db/migrations/*.sql",
    "seed:golden": "tsx --env-file=.env apps/ingestor/src/cli.ts fixtures",
    "start": "pnpm compose:up && pnpm db:migrate && pnpm db:seed && pnpm db:provision-key && pnpm --filter @comprova/api dev"
  },
  "devDependencies": {
    "@flvmnt/pgfence": "0.8.1",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.0.5",
    "fast-check": "^4.10.2",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.9.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
